{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Placar BJJ",
  "version": "1.0.1",
  "identifier": "br.com.placarbjj.sergiocorrea",
  "build": {
    "beforeBuildCommand": "node scripts/stage-desktop.cjs",
    "frontendDist": "../desktop-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Placar BJJ",
        "create": false,
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "resizable": true,
        "devtools": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
